/**
 * Unified Merchant-of-Record payment reconciliation.
 *
 * A MoR gateway (Paddle) owns tax and currency end-to-end. FluentCart's tax module
 * is OFF for Paddle, so an order is created with total_amount = catalog price in the
 * order currency and tax_total = 0. The amount the gateway actually captures can then
 * diverge from the order, and StatusHelper::syncOrderStatuses (paid iff
 * order.total_amount <= Σ succeeded transactions) mis-judges the order — leaving it
 * on-hold/pending with no fulfillment even though the buyer paid.
 *
 * reconcile() is the single entry point. It splits on currency FIRST, because that
 * decides whether a divergence is even interpretable:
 *
 *   - Same currency: a divergence is explainable. captured > order is tax-excluded
 *     (gateway added tax on top); captured < order is reverse charge (gateway removed
 *     VAT for a validated B2B buyer). Each is VERIFIED against the charge's tax fields
 *     before any order is touched.
 *   - Cross currency: amounts are not comparable (FX), so the order is recorded as
 *     covered in its own currency and the captured/FX figures are preserved in meta.
 *
 * Reporting invariant: order.total_amount = catalog price. Always. The reconciler
 * NEVER mutates the order. Paddle's tax and FX are Paddle's domain; FluentCart tracks
 * product revenue only. Authoritative captured/removed-VAT/FX figures live on the
 * transaction meta + in Paddle.
 *
 * The reconciler does NOT write the transaction row — it returns the amount/currency
 * to persist and the meta to merge, leaving the caller's single transaction save as
 * the only writer of that row.
 *
 * @see CapturedCharge for the gateway-agnostic struct the core reasons against.
 */
class PaddleReconciler
{
    /**
     * Rounding tolerance (minor units) when verifying internal totals identities.
     */
    const VERIFY_TOLERANCE = 2;
    /**
     * @param \FluentCart\App\Models\OrderTransaction $transaction The local charge transaction (pending, or already succeeded on re-entry).
     * @param array            $charge      Paddle transaction object (API/webhook shape).
     * @param \FluentCart\App\Models\Order            $order       The order being paid.
     *
     * @return array{status:string, amount:int, currency:string, changed:bool, meta:array}
     */
    public static function reconcile(\FluentCart\App\Models\OrderTransaction $transaction, $charge, \FluentCart\App\Models\Order $order): array
    {
    }
    /**
     * Convenience entry for paths that have a succeeded transaction but no live charge
     * (admin self-heal, already-succeeded webhook). Rebuilds a minimal charge from the
     * stored meta (paddle_totals / paddle_payout_totals) and reconciles. Idempotent.
     */
    public static function reconcileFromTransaction(\FluentCart\App\Models\OrderTransaction $transaction, \FluentCart\App\Models\Order $order = null): array
    {
    }
    /**
     * Same-currency route: divergence is interpretable.
     */
    protected static function sameCurrencyReconcile(\FluentCart\App\Models\OrderTransaction $transaction, \FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured, $charge, \FluentCart\App\Models\Order $order): array
    {
    }
    /**
     * Over-pay: candidate tax-excluded account (Paddle added tax on top of the price).
     * Verified currency-independently: the extra paid must equal the charge's tax, and
     * the charge's own totals identity (subtotal - discount + tax == total) must hold.
     *
     * Cover approach: order.total_amount and tax_total are raised by the tax amount so
     * that txn.total = order.total_amount (cover invariant). This keeps total_paid ==
     * total_amount in StatusHelper with no filter, and sets the correct refund ceiling:
     * min(paddle_captured, order.total_amount) = captured (admin can refund full amount
     * including tax). Atomic WHERE-guard prevents double-raise on concurrent entries.
     */
    protected static function applyTaxExcluded(\FluentCart\App\Models\OrderTransaction $transaction, \FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured, \FluentCart\App\Models\Order $order): array
    {
    }
    /**
     * Under-pay: candidate EU reverse charge (Paddle removed VAT for a validated B2B
     * buyer). Verified by the charge carrying no tax and no non-zero applied rate.
     *
     * Representation = "cover the order, keep gross": the order is left UNCHANGED (so
     * its revenue stays consistent with non-reverse-charge twins) and the transaction
     * is recorded as covering the gross order total. The real captured net and the
     * removed VAT are preserved in meta and in Paddle.
     */
    protected static function coverReverseCharge(\FluentCart\App\Models\OrderTransaction $transaction, \FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured, $charge, \FluentCart\App\Models\Order $order): array
    {
    }
    /**
     * Cross-currency route: Paddle localized checkout to the buyer's currency, so the
     * captured amount is not comparable to the order (no order->buyer rate is present
     * on the transaction, and re-deriving one would cause false declines). Record the
     * transaction as covering the order in the order currency; keep captured + FX in
     * meta. The tax sub-case is detected (for visibility) but does not change the order.
     */
    protected static function crossCurrencyReconcile(\FluentCart\App\Models\OrderTransaction $transaction, \FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured, $charge, \FluentCart\App\Models\Order $order): array
    {
    }
    /**
     * Classify the tax decision baked into a charge, independent of currency.
     * Used for cross-currency visibility (the order is not altered either way).
     *
     * @return string 'reverse_charge' | 'tax_excluded' | 'plain'
     */
    protected static function detectTaxCase(\FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured): string
    {
    }
    /**
     * Structural sanity check before a charge is treated as covering the order.
     *
     * Intentionally NOT an amount comparison: the order->buyer rate is not on the
     * transaction, so any amount check would false-decline. Instead it confirms Paddle
     * itemised and charged real money for this order's goods (positive subtotal + total,
     * and at least one line item mapped to an order item).
     */
    protected static function chargeCoversOrder($charge, \FluentCart\App\Models\Order $order): bool
    {
    }
    /**
     * True when no applied tax rate is non-zero (empty list or all 0% rates).
     */
    protected static function taxRatesAreZeroOrEmpty($taxRatesUsed): bool
    {
    }
    /**
     * Authoritative captured figures for the transaction meta.
     */
    protected static function capturedMeta(\FluentCartPro\App\Modules\PaymentMethods\PaddleGateway\CapturedCharge $captured): array
    {
    }
    /**
     * Logs and order mutations only run on the first (pre-success) reconciliation.
     * Re-entries (already-succeeded webhook, admin self-heal) stay quiet and idempotent.
