/**
 * Derives the EN 16931 VAT category code (UNCL 5305) from FluentCart's persisted
 * order tax state. Used for both the document VAT breakdown (BT-118) and per line
 * (BT-151), with the matching rate (BT-119 / BT-152) and exemption reason
 * (BT-120 text / BT-121 code).
 *
 * Handles:
 *   S  — Standard rate (rate > 0)
 *   Z  — Zero rated    (rate == 0, not exempt, not reverse charge)
 *   E  — Exempt        (explicitly flagged; carries an exemption reason)
 *   AE — Reverse charge (rate 0; carries seller + buyer VAT and an exemption reason)
 *
 * Stateless and side-effect free.
 */
final class TaxCategoryResolver
{
    const STANDARD = 'S';
    const ZERO = 'Z';
    const EXEMPT = 'E';
    const REVERSE_CHARGE = 'AE';
    /** EN 16931 VATEX code for the EU reverse-charge mechanism (Article 196). */
    const VATEX_REVERSE_CHARGE = 'VATEX-EU-AE';
    /**
     * Resolve the category for a standard / zero / exempt line or group.
     *
     * @param float $ratePercent Resolved VAT rate for the line / group.
     * @param bool  $isExempt    Whether the line is VAT-exempt (distinct from zero-rated).
     * @return array{categoryCode:string, ratePercent:float, exemptionReasonCode:string, exemptionReasonText:string}
     */
    public function resolve(float $ratePercent, bool $isExempt = false): array
    {
    }
    /**
     * Resolve a reverse-charge (AE) line or group. Always rate 0 and carries the
     * VATEX-EU-AE exemption code plus a reason (the order's declaration text when
     * supplied, else a localized default).
     *
     * @return array{categoryCode:string, ratePercent:float, exemptionReasonCode:string, exemptionReasonText:string}
     */
    public function resolveReverseCharge(string $exemptionReasonText = ''): array
    {
    }
    /**
     * @return array{categoryCode:string, ratePercent:float, exemptionReasonCode:string, exemptionReasonText:string}
     */
    private function result(string $categoryCode, float $ratePercent, string $exemptionReasonCode, string $exemptionReasonText): array
    {
    }
    private function defaultExemptReasonText(): string
    {
    }
    private function defaultReverseChargeReasonText(): string
    {
    }
}
