namespace FluentCartPro\App\Services\PDF;

/**
 * One-time migration for PDF receipt templates created before the block editor
 * was introduced. Older versions stored each PDF section as a raw core/html
 * block containing hand-written HTML. This class detects that legacy layout and
 * converts it to the new purpose-built fluent-cart blocks with proper attributes.
 *
 * Migration is idempotent: once a template is converted and saved back to the
 * database, its block sequence no longer matches LEGACY_BLOCK_SEQUENCE, so
 * subsequent calls are a no-op.
 *
 * Only default templates (is_default = true) are migrated automatically.
 * User-customised templates are left untouched.
 */
class LegacyPdfTemplateMigrator
{
    /**
     * The exact block-name sequence that identifies a legacy receipt template.
     *
     * Old format (6 blocks):
     *   [0] core/html — store header + logo
     *   [1] core/html — billing / shipping addresses
     *   [2] core/html — order meta table (number, date, payment)
     *   [3] fluent-cart/receipt-item-table — line items (already a proper block)
     *   [4] core/html — payment summary / totals
     *   [5] core/html — footer text
     */
    private const LEGACY_BLOCK_SEQUENCE = ['core/html', 'core/html', 'core/html', 'fluent-cart/receipt-item-table', 'core/html', 'core/html'];
    /**
     * Iterate over all templates, migrate any that still use the legacy layout,
     * and persist the result so the migration only runs once per template.
     *
     * @param \FluentCart\App\Services\PDF\ReceiptPdfTemplateService $service Used to save the migrated structure.
     * @param array                     $templates Keyed by template ID.
     * @return array The (potentially updated) templates array.
     */
    public static function migrateTemplates(\FluentCart\App\Services\PDF\ReceiptPdfTemplateService $service, array $templates): array
    {
    }
    /**
     * Attempt to migrate a single PDF structure.
     *
     * Returns the migrated structure on success, or null if the structure does
     * not match the legacy layout (already migrated or never was legacy).
     *
     * @param array $pdfStructure The pdf_structure array from the template settings.
     * @return array|null Migrated structure, or null if no migration was needed.
     */
    public static function migrateStructure(array $pdfStructure): ?array
    {
    }
    /**
     * Check whether the given block list matches the legacy 6-block receipt layout.
     */
    private static function matchesLegacyReceiptLayout(array $blocks): bool
    {
    }
    /**
     * Convert the six legacy core/html blocks into the new fluent-cart block
     * representations, extracting attributes from the raw HTML where possible.
     *
     * @param array $blocks Validated legacy block array (6 elements).
     * @return array New block array ready to be serialised and saved.
     */
    private static function convertLegacyBlocks(array $blocks): array
    {
    }
    // -------------------------------------------------------------------------
    // Attribute extractors — parse raw HTML from each legacy core/html block
    // -------------------------------------------------------------------------
    /**
     * Extract receipt-header attributes from the legacy header HTML.
     * Expects a two-cell table row: [logo cell, title cell].
     */
    private static function extractHeaderAttrs(string $html): array
    {
    }
    /**
     * Extract receipt-addresses attributes from the legacy addresses HTML.
     * Expects a two-cell row: [from cell, billing cell].
     */
