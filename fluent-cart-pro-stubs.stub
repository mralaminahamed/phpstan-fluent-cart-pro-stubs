class AuthorizeDotNetSubscriptions extends \FluentCart\App\Modules\PaymentMethods\Core\AbstractSubscriptionModule
{
    const ARB_RETRY_META_KEY = 'authorize_arb_retry';
    const ARB_RETRY_MARKED_AT_META_KEY = 'authorize_arb_retry_marked_at';
    // Auth.Net's CIM->ARB replication lag has been observed to take over an hour in rare
    // cases, so retries need enough headroom (12 x 5-minute ticks = 1 hour) rather than
    // giving up after the first few minutes.
    const ARB_RETRY_MAX_ATTEMPTS = 12;
    // Checking immediately after the first payment almost always hits E00040 — wait at
    // least this long from when the subscription was first queued before the very first
    // automatic retry attempt.
