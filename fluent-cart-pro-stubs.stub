    {
    }
    /**
     * Handles subscription creation failure after first payment may have already been charged.
     * Auth.Net charges remain unsettled/pending after capture — neither void nor refund is
     * reliably available at this point — so we do NOT attempt auto-reversal here. Instead we
     * log the failure and flag the transaction so an admin can void/refund manually once
     * the charge reaches a reversible state.
     * Returns the original WP_Error so caller can bubble it up.
     * Payment confirmation via IPN can try subscription creation again.
     */
    protected function handleSubscriptionCreationFailure(\WP_Error $wpError, $transaction, $subscriptionModel, array $profile = []): \WP_Error
