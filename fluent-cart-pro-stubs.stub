namespace FluentCartPro\App\Modules\PaymentMethods\PaddleGateway;

/**
 * Gateway-agnostic normalized view of what a Merchant-of-Record actually captured.
 *
 * The reconciliation core reasons only against this struct, never against a raw
 * gateway payload. A thin per-gateway adapter (here: ::fromPaddle) maps the
 * provider response onto these fields. To onboard another MoR gateway, add a
 * sibling adapter that produces a CapturedCharge — the reconciler does not change.
 *
 * All money is in integer minor units (cents) in the charged currency.
 */
class CapturedCharge
{
    /** @var string Charged (buyer) currency, uppercased. Empty if unknown. */
    public $currency = '';
    /** @var int Net goods total before tax (after per-line discounts). */
    public $subtotal = 0;
    /** @var int Discount total. */
    public $discount = 0;
    /** @var int Tax total. 0 == tax not applied (exempt / reverse charge). */
    public $tax = 0;
    /** @var int Captured total = subtotal - discount + tax. */
    public $total = 0;
    /** @var array Raw totals blob (kept for meta/accounting). */
    public $totals = [];
    /** @var array Line items (provider shape, used for refund/recurring mapping). */
    public $lineItems = [];
    /** @var array Applied tax rates. Empty/0% corroborates reverse charge. */
    public $taxRatesUsed = [];
    /** @var array FX / payout blob (exchange_rate + settled amount). */
    public $fx = [];
    /** @var array Top-level checkout items (carry billing_cycle for recurring detection). */
    public $items = [];
    /**
     * Build a normalized charge from a Paddle transaction object
     * (GET /transactions/{id} -> data, or a webhook transaction payload).
     */
    public static function fromPaddle($charge): self
    {
    }
}
