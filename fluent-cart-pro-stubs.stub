    {
    }
    /**
     * Extract receipt-meta (order info) attributes from the legacy meta HTML.
     * Parses a two-column table of label / value rows.
     */
    private static function extractMetaAttrs(string $html): array
    {
    }
    /**
     * Extract receipt-payment-summary attributes from the legacy totals HTML.
     * The last table row is treated as the grand total; all preceding rows are
     * line items (subtotal, tax, shipping, discount, etc.).
     */
